<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <!-- Основной NuGet источник -->
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    
    <!-- Российские зеркала NuGet (раскомментируйте при необходимости) -->
    <!-- <add key="nuget-mos" value="https://nexus.mos.ru/repository/nuget-proxy/v3/index.json" protocolVersion="3" /> -->
    <!-- <add key="nuget-yandex" value="https://nuget.yandex.ru/v3/index.json" protocolVersion="3" /> -->
  </packageSources>

  <packageRestore>
    <add key="enabled" value="True" />
    <add key="automatic" value="True" />
  </packageRestore>

  <bindingRedirects>
    <add key="skip" value="False" />
  </bindingRedirects>

  <packageManagement>
    <add key="format" value="1" />
    <add key="disabled" value="False" />
  </packageManagement>

  <!-- Настройки для работы через прокси (если нужно) -->
  <!--
  <config>
    <add key="http_proxy" value="http://proxy.company.ru:8080" />
    <add key="https_proxy" value="http://proxy.company.ru:8080" />
  </config>
  -->
</configuration>